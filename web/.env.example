# Backend FastAPI server URL (leave empty in dev to use Vite proxy, or set to your Render backend URL in prod)
VITE_API_BASE_URL=https://resumely-backend.onrender.com

# Supabase Auth configuration (optional overrides)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
